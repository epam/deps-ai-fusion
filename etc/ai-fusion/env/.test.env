ENV=testing

# Database
DATABASE_HOST=test-database
DATABASE_PORT=5432
DATABASE_DB=test_deps
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
MASTER_CHANGELOG=./migrations/master.yaml
TESTING=true
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

SENTRY_ENABLED=False
SENTRY_DSN=

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@test-rabbitmq:5672/test_deps

# kafka
KAFKA_GROUP_ID=ai-fusion

# Auth
AUTH_VERIFY_SSL=false

ASB_SUBSCRIPTION_NAME=ai-fusion

SUPPORTED_PROVIDERS=["dial"]

DOCUMENT_SERVICE_URL=http://deps-document-api:8000
FILE_SERVICE_URL=http://deps-file:8000
PARSING_SERVICE_URL=http://deps-parsing:8000
FILE_STORAGE_URL=http://deps-file-storage:8004
META_AGENT_URL=http://deps-meta-agent:8000
AGENTIC_AI_URL=http://deps-agentic-ai:8000
GENAI_QUERY_AGENT_URL=http://deps-ai-fusion:12754
UNIFIER_URL=http://deps-unifier:8000

EPAM_DIAL_ENDPOINT=https://host_azure_api_endpoint
EPAM_DIAL_API_KEY=...
EPAM_DIAL_API_VERSION=2023-03-15-preview

LLMS_CONFIG='{"providers":{}}'

EXTRACTION_URL=http://extraction

LLM_COORDINATES_ENABLED=false
